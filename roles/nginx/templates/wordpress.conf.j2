server {
    listen 80;
    server_name {{ wordpress_domain }};
    root {{ wordpress_install_dir }};
    index index.php index.html;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:{{ php_fpm_socket }};
    }
}
